{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pregen.org/spec/schemas/terms.json",
  "title": "pg.terms.v1 body (extension terms; rules shaped by likeness/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signers",
    "subject_ref",
    "profile",
    "version",
    "template",
    "legal",
    "rules",
    "minor",
    "assent",
    "instruction",
    "issued_at"
  ],
  "if": {
    "properties": {
      "version": {
        "const": 1
      }
    }
  },
  "then": {
    "required": [
      "factor"
    ],
    "not": {
      "required": [
        "amends"
      ]
    }
  },
  "else": {
    "required": [
      "amends"
    ]
  },
  "properties": {
    "signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "key_id"
          ],
          "properties": {
            "role": {
              "const": "registry"
            },
            "key_id": {
              "type": "string",
              "pattern": "^pg-ed25519:[0-9a-f]{32}$",
              "minLength": 43,
              "maxLength": 43
            }
          }
        }
      ],
      "items": false
    },
    "subject_ref": {
      "$ref": "#/$defs/ascii",
      "pattern": "^TOG-[0-9A-Z*~$=!-]{3,48}$"
    },
    "profile": {
      "const": "likeness/1",
      "description": "the profile whose rules shape and vocabulary this record uses; another profile brings its own rules shape"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "1, then one more for each version of this subject's terms"
    },
    "amends": {
      "$ref": "#/$defs/hex64",
      "description": "the message id of the version before; present exactly when version > 1"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "jurisdiction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ascii",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "minLength": 2,
          "maxLength": 2,
          "description": "an ISO 3166-1 alpha-2 code, or a reserved one such as EU"
        }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "url"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hex64",
          "description": "SHA-256 of the template's legal text, byte for byte"
        },
        "url": {
          "$ref": "#/$defs/ascii",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "description": "the template's legal text: it governs process, remedies and interpretation, never scope"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purposes",
        "excluded_categories"
      ],
      "properties": {
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "personal",
              "educational",
              "research",
              "editorial",
              "commercial"
            ]
          },
          "description": "sorted in code point order"
        },
        "excluded_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/category"
          },
          "description": "sorted in code point order; may be empty"
        }
      },
      "description": "the machine layer; it alone governs scope"
    },
    "minor": {
      "type": "boolean",
      "description": "whether the registry knew the subject to be a minor when it signed this version"
    },
    "assent": {
      "enum": [
        "self",
        "registry",
        "agent"
      ],
      "not": {
        "enum": [
          "self",
          "agent"
        ]
      },
      "description": "who stands behind the record on the subject's side; only registry (the registry's word: the subject's authenticated instruction, or the registry's own closing act) is defined; self and agent are reserved and refused"
    },
    "instruction": {
      "$ref": "#/$defs/hex64",
      "description": "SHA-256 of the canonical form of the registry's private record of the act that made this version"
    },
    "factor": {
      "enum": [
        "authenticator",
        "email"
      ],
      "description": "the second factor the registry checked; present exactly when this version opens (extensions/terms.md)"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "ascii": {
      "type": "string",
      "not": {
        "pattern": "[^!-~]"
      },
      "description": "printable ASCII without spaces: no control or format character, and no trailing newline that a pattern's $ would let through"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "category": {
      "enum": [
        "adult",
        "advertising",
        "alcohol",
        "cannabis",
        "drugs",
        "endorsement",
        "fashion",
        "financial",
        "gambling",
        "health",
        "political",
        "religion",
        "sexual",
        "tobacco",
        "violence",
        "weapons"
      ],
      "description": "likeness/1's closed vocabulary of content categories (profiles/likeness-1.md)"
    }
  }
}
