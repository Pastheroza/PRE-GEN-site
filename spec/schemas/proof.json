{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pregen.org/spec/schemas/proof.json",
  "title": "pg.proof.v1 bundle (unsigned container; every part is signed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "subjects"
  ],
  "properties": {
    "format": {
      "const": "pg.proof.v1"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "answer",
          "report",
          "ack"
        ],
        "properties": {
          "request": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ]
          },
          "answer": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ]
          },
          "report": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ]
          },
          "ack": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ]
          },
          "terms": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ],
            "description": "extension terms: the pg.terms.v1 envelope whose message id the request carries"
          },
          "code": {
            "type": "string",
            "pattern": "^TOG-PG-",
            "description": "TOG-CODE.md section 14: a readable copy of the entry's act code; recomputed from the signed parts, never trusted"
          },
          "licence": {
            "type": "string",
            "pattern": "^TOG-LIC-",
            "description": "TOG-CODE.md section 14: a readable copy of the licence's code, only when the answer's basis names a licence"
          },
          "grant": {
            "type": "object",
            "required": [
              "type",
              "body",
              "signatures"
            ],
            "description": "the pg.grant.v1 envelope the answer's basis names, so that licence can be recomputed"
          }
        }
      }
    }
  }
}
