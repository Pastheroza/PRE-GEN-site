{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pregen.org/spec/schemas/request.json",
  "title": "pg.request.v1 body (core; optional members from extensions)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "provider_id",
    "profile",
    "use",
    "job_id",
    "job_hash"
  ],
  "properties": {
    "signers": {
      "type": "array",
      "description": "extension provider-identity: [{role: provider, key_id}]; required for a provider URL (provider-identity P-1); a registry may also accept it beside a registry-issued credential"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^PG-[0-9A-Z*~$=!-]{3,48}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[0-9]+$",
      "description": "the fixed name of a vocabulary of uses (PRE-GEN-CORE.md, Profiles); compared only as a name, never a version"
    },
    "use": {
      "type": "object"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "job_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "licensee_id": {
      "type": "string",
      "maxLength": 255,
      "description": "extension licensee"
    },
    "mode": {
      "enum": [
        "enforce",
        "observe"
      ],
      "description": "extension observe"
    },
    "ext": {
      "type": "object"
    }
  }
}
