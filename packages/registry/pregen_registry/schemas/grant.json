{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pregen.org/spec/schemas/grant.json",
  "title": "pg.grant.v1 body (extension grants)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signers",
    "subject_ref",
    "licensee_id",
    "profile",
    "use",
    "not_before",
    "expires_at",
    "max_uses"
  ],
  "properties": {
    "signers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "key_id"
          ],
          "properties": {
            "role": {
              "const": "rights_holder"
            },
            "key_id": {
              "type": "string",
              "pattern": "^pg-ed25519:[0-9a-f]{32}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "key_id"
          ],
          "properties": {
            "role": {
              "const": "registry"
            },
            "key_id": {
              "type": "string",
              "pattern": "^pg-ed25519:[0-9a-f]{32}$"
            }
          }
        }
      ],
      "items": false
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^PG-[0-9A-Z*~$=!-]{3,48}$"
    },
    "licensee_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "use": {
      "type": "object"
    },
    "not_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_uses": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "type": "object"
    }
  }
}
