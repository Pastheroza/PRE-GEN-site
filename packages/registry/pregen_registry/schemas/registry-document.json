{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pregen.org/spec/schemas/registry-document.json",
  "title": "GET /.well-known/pregen-registry.json",
  "type": "object",
  "required": [
    "prefix",
    "name",
    "api",
    "keys",
    "profiles",
    "extensions",
    "policy",
    "complaints",
    "sandbox",
    "spec"
  ],
  "properties": {
    "prefix": {
      "type": "string",
      "pattern": "^((?!LIC)(?![A-Z]*LIC$)(?!L[A-Z]IC$)(?!LI[A-Z]C$)[A-Z]{4,8})?$"
    },
    "name": {
      "type": "string"
    },
    "api": {
      "type": "string",
      "pattern": "^https?://"
    },
    "keys": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "enum": [
          "reports",
          "provider-keys",
          "limits",
          "jobs",
          "grants",
          "licensee",
          "observe",
          "sandbox",
          "lookup",
          "identity",
          "proof",
          "catalog",
          "provider-identity",
          "bind",
          "terms",
          "commerce"
        ]
      },
      "description": "commerce: a registry's own, optional second layer (selling licences); its terms are the registry's own page until a shared extension is published"
    },
    "policy": {
      "type": "string"
    },
    "complaints": {
      "type": "string"
    },
    "sandbox": {
      "type": "boolean"
    },
    "spec": {
      "type": "string"
    },
    "providers": {
      "enum": [
        "open",
        "registered"
      ],
      "description": "extension provider-identity: open = providers known by their domain are accepted; registered = this registry issues its own credentials (the default when absent)"
    },
    "bind": {
      "type": "object",
      "required": [
        "authorize",
        "token"
      ],
      "properties": {
        "authorize": {
          "type": "string",
          "pattern": "^https://"
        },
        "token": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "description": "extension bind: where a person connects their licences to an app"
    },
    "terms": {
      "const": "optional",
      "description": "extension terms: subjects may have terms, and a request may accept them; absent means the registry publishes none"
    }
  }
}
